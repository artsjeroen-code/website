server {
    server_name test-artsjeroen.ddns.net;

    root /var/www/staging;

    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    index index.html;

    location = /tools/focus/api/health {
        proxy_pass http://127.0.0.1:8768/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /tools/focus/api/auth/status {
        proxy_pass http://127.0.0.1:8768/auth/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /tools/focus/api/auth/login {
        proxy_pass http://127.0.0.1:8768/auth/login;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /tools/focus/api/auth/logout {
        proxy_pass http://127.0.0.1:8768/auth/logout;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /tools/focus/api/tasks {
        proxy_pass http://127.0.0.1:8768/tasks;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /tools/focus/api/tasks/ {
        proxy_pass http://127.0.0.1:8768/tasks/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # Maak de testomgeving visueel direct herkenbaar, zonder productiecode
        # aan te passen. De injectie geldt alleen voor HTML op dit testdomein.
        sub_filter_once on;
        sub_filter '</head>' '<style id="staging-environment-style">:root{--staging-bg:#fff0b3}:root[data-theme="dark"]{--staging-bg:#3a2d0b}html,body{background:var(--staging-bg)!important}</style></head>';

        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/test-artsjeroen.ddns.net/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/test-artsjeroen.ddns.net/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = test-artsjeroen.ddns.net) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name test-artsjeroen.ddns.net;
    return 404; # managed by Certbot
}
